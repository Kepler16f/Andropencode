<?xml version="1.0" encoding="utf-8"?>
<!--
  Re-declared under drawable-v24/ so older Android versions (API < 26) do
  not even attempt to inflate the vector. drawable-anydpi-v26 will override
  this on API 26+ launchers; on older devices the launcher reads the legacy
  mipmap-*dpi PNG instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <path
        android:strokeColor="#F0F6FC"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 54,32 a 22,22 0 1,1 -0.01,0 z" />

    <path
        android:strokeColor="#58A6FF"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M 50,68 L 58,68" />
</vector>